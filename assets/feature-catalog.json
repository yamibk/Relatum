{
  "version": 1,
  "workspaces": [
    {
      "id": "canvas",
      "label": [
        "画布",
        "Canvas"
      ],
      "panel": "start-canvas-workspace",
      "defaultVisible": true
    },
    {
      "id": "notes",
      "label": [
        "笔记",
        "Notes"
      ],
      "panel": "start-notes-workspace",
      "defaultVisible": true
    },
    {
      "id": "research",
      "label": [
        "研究",
        "Research"
      ],
      "panel": "start-research-workspace",
      "defaultVisible": true
    },
    {
      "id": "career",
      "label": [
        "生涯",
        "Career"
      ],
      "panel": "start-career-workspace",
      "defaultVisible": true
    },
    {
      "id": "daily",
      "label": [
        "日常",
        "Daily"
      ],
      "panel": "start-daily-workspace",
      "defaultVisible": false
    }
  ],
  "features": [
    {
      "id": "canvas",
      "label": "画布工作区",
      "description": "画布文件管理、编辑器、复习、活跃、速记、树状和学习。",
      "default": true
    },
    {
      "id": "canvas.library",
      "parent": "canvas",
      "home": true,
      "label": "画布文件管理",
      "description": "最近、分组、收藏、导入与回收站。可与编辑器分别选择。",
      "writePaths": [
        "/api/new",
        "/api/pick",
        "/api/import-canvas-file",
        "/api/import-canvas-folder",
        "/api/import-canvas",
        "/api/recent-sync",
        "/api/remove",
        "/api/group-create",
        "/api/group-rename",
        "/api/group-delete",
        "/api/file-set-group",
        "/api/favorite-toggle",
        "/api/groups-reorder",
        "/api/reorder-files",
        "/api/trash",
        "/api/trash-list",
        "/api/trash-empty",
        "/api/restore"
      ],
      "default": true
    },
    {
      "id": "canvas.editor",
      "parent": "canvas",
      "label": ".canvas 编辑器",
      "description": "打开和编辑画布。仅启用编辑器时需要先选择现有文件。",
      "scripts": [
        "canvas.js",
        "editor.js",
        "editor-lazy.js",
        "dual-viewer.js",
        "canvas-changes.js",
        "ruler.js",
        "canvas-import.js",
        "dual-clipboard.js",
        "node-matrix.js",
        "canvas-timer.js",
        "canvas-scenes.js",
        "canvas-taskbook.js",
        "markdown-notebook.js",
        "richtext.js",
        "markdown-table.js",
        "editor-onboarding.js",
        "editor-onboarding.css",
        "table-editor.js"
      ],
      "pages": [
        "editor.html",
        "dual-viewer.html"
      ],
      "readPaths": [
        "/api/load",
        "/api/templates",
        "/api/canvas-import-source",
        "/api/canvas-import-library",
        "/api/canvas-dual-open"
      ],
      "writePaths": [
        "/api/save",
        "/api/clean-assets",
        "/api/export-markdown",
        "/api/export-png",
        "/api/import-markdown",
        "/api/canvas-import-assets",
        "/api/import-canvas-image",
        "/api/upload-canvas-image",
        "/api/upload-canvas-attachment",
        "/api/save-canvas-annotation",
        "/api/save-node-annotations",
        "/api/templates-save",
        "/api/viewport",
        "/api/open",
        "/api/taskbook-archive",
        "/api/canvas-dual-open",
        "/api/canvas-import-library",
        "/api/canvas-import-source"
      ],
      "default": true
    },
    {
      "id": "editor.ai",
      "parent": "canvas.editor",
      "label": "AI 助手",
      "description": "AI 对话与受控画布计划；关闭后不加载或预热 AI。",
      "scripts": [
        "ai.js",
        "ai-canvas-plan.js"
      ],
      "readPrefixes": [
        "/api/ai-"
      ],
      "writePrefixes": [
        "/api/ai-"
      ],
      "default": true
    },
    {
      "id": "editor.graph",
      "parent": "canvas.editor",
      "label": "画布图谱",
      "description": "编辑器图谱浮层；关闭后不加载或预热图谱。",
      "scripts": [
        "graph-view.js"
      ],
      "default": true
    },
    {
      "id": "canvas.review",
      "parent": "canvas",
      "label": "复习",
      "description": "独立卡片库与复习。",
      "view": "review",
      "home": true,
      "role": "review-view",
      "scripts": [
        "review-controls.js",
        "review-controls.css",
        "review.js",
        "review-import.js",
        "review-import-model.js",
        "review-import-worker.js",
        "review-import.css",
        "vendor/sheetjs/"
      ],
      "writePrefixes": [
        "/api/review-"
      ],
      "default": true
    },
    {
      "id": "daily.calendar",
      "parent": "daily",
      "label": "日历与日记",
      "description": "日历、日记与倒数日。",
      "view": "calendar",
      "scripts": [
        "calendar.js",
        "daily-calendar.css",
        "countdown.js"
      ],
      "pages": [
        "countdown.html"
      ],
      "writePaths": [
        "/api/diary-save",
        "/api/diary-delete",
        "/api/countdown-save"
      ],
      "default": true,
      "readPaths": [
        "/api/calendar",
        "/api/countdown"
      ]
    },
    {
      "id": "daily.calendar.wallpaper",
      "parent": "daily.calendar",
      "label": "动态桌面背景",
      "description": "允许倒数日启动独立桌面背景进程。关闭后不创建背景宿主。",
      "default": true
    },
    {
      "id": "canvas.activity",
      "parent": "canvas",
      "label": "活跃",
      "description": "活跃热力图与足迹星图。",
      "view": "cadence",
      "home": true,
      "role": "cadence-view",
      "scripts": [
        "study-activity.js",
        "study-graph.js"
      ],
      "default": true
    },
    {
      "id": "canvas.quicknotes",
      "parent": "canvas",
      "label": "速记",
      "description": "速记便签墙。",
      "view": "notes",
      "home": true,
      "role": "notes-view",
      "scripts": [
        "notes.js"
      ],
      "writePaths": [
        "/api/notes-save",
        "/api/notes-archive"
      ],
      "default": true
    },
    {
      "id": "canvas.tree",
      "parent": "canvas",
      "label": "树状",
      "description": "独立树状页。",
      "view": "tree",
      "home": true,
      "role": "tree-page-view",
      "scripts": [
        "tree-page.js"
      ],
      "writePrefixes": [
        "/api/tree-page"
      ],
      "default": true
    },
    {
      "id": "canvas.study",
      "parent": "canvas",
      "label": "学习",
      "description": "学习任务、目标树和路线。",
      "view": "study",
      "home": true,
      "role": "study-view",
      "scripts": [
        "study.js",
        "study-route.js"
      ],
      "writePrefixes": [
        "/api/study-"
      ],
      "default": true
    },
    {
      "id": "daily.focus",
      "parent": "daily",
      "label": "专注",
      "description": "独立专注计时、成果记录与声音。",
      "view": "focus",
      "scripts": [
        "focus.js",
        "focus-service.js",
        "daily-focus.css",
        "daily-focus.html"
      ],
      "writePrefixes": [
        "/api/focus-"
      ],
      "default": true,
      "readPaths": [
        "/api/focus"
      ]
    },
    {
      "id": "notes",
      "label": "笔记工作区",
      "description": "Markdown 文件树、多标签编辑与阅读。",
      "scripts": [
        "markdown-table.js",
        "note-table-editor.js",
        "note-workspace.js",
        "note-system.js",
        "note-sidebar-settings.js",
        "note-extensions.js",
        "note-extensions-settings.js",
        "note-extensions.css",
        "note-extensions/",
        "note-guide.js",
        "note-browser.js",
        "note-live-editor.js",
        "note-media-frame.js",
        "note-shortcuts.js",
        "vendor/codemirror/relatum-codemirror.min.js"
      ],
      "readPaths": [
        "/api/note",
        "/api/notes-tree"
      ],
      "readPrefixes": [
        "/api/note-"
      ],
      "writePrefixes": [
        "/api/note-"
      ],
      "default": true
    },
    {
      "id": "notes.ai",
      "parent": "notes",
      "label": "笔记 AI",
      "description": "临时聊天和系统预设，对话退出后不保存；关闭后不加载 AI 或访问其配置和服务。",
      "scripts": [
        "note-ai.js",
        "note-ai.css"
      ],
      "readPrefixes": [
        "/api/note-ai/"
      ],
      "writePrefixes": [
        "/api/note-ai/"
      ],
      "default": true
    },
    {
      "id": "notes.graph",
      "parent": "notes",
      "label": "笔记图谱",
      "description": "笔记本关系图谱；关闭后不加载图谱脚本、数据或绘制引擎。",
      "scripts": [
        "note-graph.js",
        "note-graph-layout-worker.js"
      ],
      "readPaths": [
        "/api/note-graph"
      ],
      "default": true
    },
    {
      "id": "notes.mermaid",
      "parent": "notes",
      "label": "Mermaid 图表",
      "description": "笔记中的 Mermaid 图表，使用离线 Pele 引擎；关闭后保留代码，不加载专属脚本、样式或引擎。",
      "scripts": [
        "note-mermaid.js",
        "note-mermaid-worker.js",
        "note-mermaid.css",
        "vendor/pele/"
      ],
      "default": true
    },
    {
      "id": "notes.quiz",
      "parent": "notes",
      "label": "笔记选择题",
      "description": "笔记中的交互单选题；关闭后保留源码，不加载选择题专属脚本或样式。",
      "scripts": [
        "note-quiz-core.js",
        "note-quiz.js",
        "note-quiz.css"
      ],
      "default": true
    },
    {
      "id": "notes.canvas",
      "parent": "notes",
      "label": "笔记内嵌画布",
      "description": "笔记中的独立画布块；关闭后显示原引用，不加载引擎或读取画布。",
      "scripts": [
        "note-canvas/",
        "note-canvas-style.js"
      ],
      "readPrefixes": [
        "/api/notes-canvas/"
      ],
      "writePrefixes": [
        "/api/notes-canvas/"
      ],
      "default": true
    },
    {
      "id": "research",
      "label": "研究工作区",
      "description": "研究画布、子电路和仿真。",
      "scripts": [
        "research/"
      ],
      "pages": [
        "research.html"
      ],
      "readPrefixes": [
        "/api/research/"
      ],
      "writePrefixes": [
        "/api/research/"
      ],
      "default": true
    },
    {
      "id": "career",
      "label": "生涯工作区",
      "description": "本地冻结使用报告。关闭后不预载报告。",
      "scripts": [
        "career-report.js",
        "career/"
      ],
      "readPrefixes": [
        "/api/career/"
      ],
      "writePrefixes": [
        "/api/career/"
      ],
      "default": true
    },
    {
      "id": "runtime.preload",
      "label": "后台预加载",
      "description": "提前准备未打开的页面、笔记编辑器和展示字体。取消后首次使用时加载，减少启动后的内存占用；所有已选功能仍可使用。",
      "default": true
    },
    {
      "id": "daily",
      "label": "日常工作区",
      "description": "每日任务、日历、专注与记账。",
      "default": true,
      "availableWhenAny": [
        "daily.tasks",
        "daily.calendar",
        "daily.focus",
        "daily.ledger"
      ],
      "scripts": [
        "daily-workspace.js",
        "daily-workspace.css"
      ]
    },
    {
      "id": "daily.tasks",
      "parent": "daily",
      "label": "每日任务",
      "description": "分组、每日打卡与累计目标。",
      "default": true,
      "scripts": [
        "daily-tasks.js",
        "daily-tasks.css",
        "daily-tasks.html"
      ],
      "readPaths": [
        "/api/daily"
      ],
      "writePrefixes": [
        "/api/daily-"
      ]
    },
    {
      "id": "daily.ledger",
      "parent": "daily",
      "label": "记账",
      "description": "独立收支账本。",
      "default": true,
      "scripts": [
        "ledger.js",
        "ledger-model.js",
        "daily-ledger.css"
      ],
      "readPaths": [
        "/api/ledger"
      ],
      "writePrefixes": [
        "/api/ledger-"
      ]
    }
  ],
